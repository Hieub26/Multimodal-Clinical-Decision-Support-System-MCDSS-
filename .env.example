# ============================================
# Multimodal Clinical Decision Support System
# Environment Configuration
# ============================================
# Copy to .env and fill in the values marked "required".
# Every variable maps to a field in app/config.py; anything left out
# falls back to the default defined there.

# --- LLM Provider ---
# Optional: without a key the system uses the rule-based fallback engine.
GEMINI_API_KEY=
LLM_MODEL_NAME=gemini-2.5-flash

# --- Jev (TypeSafe System One) ---
# Optional. With a key, Jev reads what the text says about each symptom
# (present, denied, past, someone else's, asked about) and adds emergency
# warning signs to the red-flag gate. The patient's text is sent to TypeSafe.
# Without a key, or when a call fails, the rule-based logic is used.
TYPESAFE_API_KEY=
JEV_ENABLED=true
# Pinned: the thresholds in the code were tuned against this version.
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=2.5
# Whether Jev may drop a keyword red flag it reads as history.
JEV_CLEAR_HISTORY_RED_FLAGS=true

# --- Embedding Model ---
# Changing this rebuilds the guideline index on the next start.
EMBEDDING_MODEL_NAME=pritamdeka/S-BioBert-snli-multinli-stsb

# --- ChromaDB ---
CHROMA_COLLECTION_NAME=clinical_guidelines
# CHROMA_PERSIST_DIR defaults to <project>/data/chroma_db

# --- CV Model ---
# The weights file is not in the repository. Image diagnosis returns 503
# until it exists. Defaults:
#   CV_MODEL_PATH=<project>/models/best_densenet121_chestxray14.pth
#   CV_MODEL_META_PATH=<project>/models/best_densenet121_chestxray14_meta.json
CV_IMAGE_SIZE=224
CV_THRESHOLD_RELAXATION=0.84
CV_NEGATIVE_SCREEN_RATIO_THRESHOLD=0.65

# --- Safety & Confidence Thresholds ---
CONFIDENCE_THRESHOLD_CV=0.30
CONFIDENCE_THRESHOLD_NLP=0.70
SAFETY_THRESHOLD=0.15
VLM_SAFETY_ENABLED=true
VLM_SAFETY_MODEL=gemini-2.5-flash

# --- Database (PostgreSQL, required) ---
# POSTGRES_USER / POSTGRES_PASSWORD are used by docker-compose, which builds
# its own DATABASE_URL pointing at the db service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/clinical_dss

# --- Server ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8008
STREAMLIT_PORT=8501
# Optional: when set, POST /api/nlp/ingest-guidelines requires this value
# in the X-API-Key header.
ADMIN_API_KEY=
MAX_UPLOAD_SIZE_MB=20

# --- Logging ---
# Logs hold no patient text, only lengths, counts and outcomes.
LOG_LEVEL=INFO
# LOG_DIR defaults to <project>/storage/logs
